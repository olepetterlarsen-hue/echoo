# Kopier denne filen til .env.local og fyll inn verdier.
# I prod (Netlify): sett alle disse under Site configuration → Environment variables.

# === Supabase (påkrevd) ===
# Settings → API i Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key brukes av server-actions for admin-operasjoner
# (opprette brukere, signup_organization RPC). Skal ALDRI eksponeres til klient.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === App ===
# Public app URL (brukes ved e-post-bekreftelser og passord-reset).
# I prod: https://app.echoo.no (eller hva dere har).
# I dev: http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Landingssiden — vises som "Tilbake til echoo.no"-lenke på /login.
# Hopp over for split der app og landing er på samme domene.
NEXT_PUBLIC_LANDING_URL=https://echoo.no

# === Anthropic AI (valgfritt) ===
# Trengs for AI-mal-bygger i /admin/maler. Hopp over hvis dere ikke skal bruke AI.
ANTHROPIC_API_KEY=your-anthropic-key

# === E-post via Resend (valgfritt) ===
# Trengs for varsler ved tildelte oppgaver/avvik/kommentarer.
RESEND_API_KEY=your-resend-key
EMAIL_FROM=Echoo <noreply@echoo.no>

# === Next.js Server Actions (anbefalt) ===
# Generér med: openssl rand -base64 32
# Holder action-ID-er stabile på tvers av deploys — uten denne får
# brukere "Server Action not found"-feil etter hver Netlify-deploy.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32
